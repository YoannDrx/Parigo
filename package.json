{
  "name": "parigo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/home.spec.ts e2e/editorial-pages.spec.ts e2e/parigo-editorial-catalog.spec.ts --project=desktop --grep \"homepage rend la recherche principale|pages d’information alignent leurs corners|pages anglaises exposent canoniques\"",
    "email:dev": "email dev --dir src/emails --port 3001",
    "test:harvest": "node --env-file=.env --import tsx docs/harvest/smoke-tests/harvest-api-smoke-test.ts",
    "audit:harvest:docs": "node --import tsx scripts/refresh-harvest-endpoint-inventory.ts && node --import tsx scripts/generate-harvest-api-audit-inventories.ts && node --import tsx scripts/generate-harvest-code-conformance-matrix.ts",
    "audit:harvest:public-read": "HARVEST_PUBLIC_READ_AUDIT=1 node --env-file=.env --import tsx docs/harvest/smoke-tests/public-read-conformance-audit.ts",
    "test:harvest:composers": "node --env-file=.env --import tsx docs/harvest/smoke-tests/composer-credit-smoke-test.ts",
    "test:harvest:composers:clean": "HARVEST_LIVE_TESTS=1 HARVEST_COMPOSER_CLEAN_EXPECTED=1 node --env-file=.env --import tsx docs/harvest/smoke-tests/composer-credit-smoke-test.ts",
    "audit:harvest:composers": "HARVEST_LIVE_TESTS=1 WRITE_EDITORIAL_AUDIT=1 node --env-file=.env --import tsx docs/harvest/smoke-tests/composer-credit-smoke-test.ts",
    "export:harvest:composer-cleanup": "node --import tsx scripts/export-harvest-composer-cleanup.ts",
    "audit:harvest:gaps": "node --import tsx scripts/audit-harvest-gaps.ts",
    "audit:youtube:clips": "node --env-file-if-exists=.env --import tsx scripts/audit-youtube-clips.ts",
    "audit:editorial:orphans": "node --env-file-if-exists=.env --import tsx scripts/audit-editorial-orphans.ts",
    "matching:sync-portfolio": "node --import tsx scripts/sync-matching-portfolio.ts",
    "matching:validate": "node --import tsx scripts/validate-matching.ts",
    "matching:apply": "node --import tsx scripts/apply-matching-review.ts",
    "test:harvest:member": "node --env-file=.env --import tsx docs/harvest/smoke-tests/member-mutations.ts",
    "audit:harvest:member": "HARVEST_MEMBER_AUDIT=1 node --env-file=.env --import tsx docs/harvest/smoke-tests/member-integration-audit.ts",
    "audit:harvest:member:direct": "HARVEST_MEMBER_DIAGNOSTICS=1 node --env-file=.env --import tsx docs/harvest/smoke-tests/member-direct-diagnostics.ts",
    "audit:harvest:member:ui": "HARVEST_MEMBER_UI_AUDIT=1 node --env-file=.env --import tsx docs/harvest/smoke-tests/member-ui-audit.ts",
    "audit:harvest:capabilities": "HARVEST_MEMBER_CAPABILITIES_AUDIT=1 node --env-file=.env --import tsx docs/harvest/smoke-tests/member-capabilities-audit.ts",
    "test:search-contract": "node --env-file-if-exists=.env --import tsx docs/harvest/smoke-tests/search-contract.ts",
    "migrate:editorial": "node --import tsx scripts/migrate-editorial-content.ts",
    "sync:composers": "node --import tsx scripts/sync-canonical-composers.ts",
    "validate:assets": "node --import tsx scripts/validate-public-assets.ts",
    "validate:budgets": "node --import tsx scripts/validate-build-budgets.ts",
    "test:seo": "node --env-file-if-exists=.env --import tsx scripts/verify-seo.ts",
    "test:lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@react-email/render": "2.1.0",
    "@sentry/nextjs": "10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "howler": "^2.2.4",
    "jose": "^6.2.5",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "tailwind-merge": "^3.6.0",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "16.2.12",
    "@playwright/test": "^1.62.1",
    "@react-email/ui": "6.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "react-email": "6.9.1",
    "sharp": "0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri@3.1.4": "3.1.5",
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}

# =============================================================================
# Harvest Media Public API — application
# =============================================================================
# Identifiants obligatoires du catalogue.
HARVEST_CLIENT_ID=""
HARVEST_CLIENT_SECRET=""
HARVEST_ACCESS_KEY=""

# Endpoints officiels. Laisser la région vide pour la détection automatique.
HARVEST_AUTH_URL=""
HARVEST_SERVICE_URL=""
HARVEST_AUTH_GRANT_TYPE=""
HARVEST_DEFAULT_REGION_ID=""

# Comptes membres, recherche éditoriale et partage de playlists.
HARVEST_SESSION_SECRET=""
HARVEST_SEARCH_FIELD_PROFILE=""
HARVEST_PLAYLIST_SHARING_ENABLED=""

# =============================================================================
# AIMS via la Public API Harvest
# =============================================================================
# Le contrat et chaque source doivent être activés explicitement.
AIMS_CONTRACT_VERIFIED="0"
AIMS_TRACK_SEARCH_ENABLED="0"
AIMS_PROMPT_SEARCH_ENABLED="0"
# Temporaire tant que ServiceInfo annonce le prompt avec Allow=false.
AIMS_PROMPT_CAPABILITY_OVERRIDE="0"
AIMS_UPLOAD_SEARCH_ENABLED="0"
AIMS_URL_SEARCH_ENABLED="0"
# URL publique contrôlée utilisée uniquement par la suite live opt-in.
HARVEST_AIMS_TEST_EXTERNAL_URL="https://music.youtube.com/watch?v=ZbZSe6N_BXs"
# Secret indépendant de 32 caractères minimum pour les références opaques.
AIMS_REFERENCE_TOKEN_SECRET=""

# =============================================================================
# Comptes réservés aux tests Harvest
# =============================================================================
# Ne jamais utiliser de comptes utilisateurs réels pour ces diagnostics.
HARVEST_TEST_MEMBER_EMAIL=""
HARVEST_TEST_MEMBER_PASSWORD=""
HARVEST_TEST_RECIPIENT_EMAIL=""
HARVEST_TEST_RECIPIENT_PASSWORD=""

# =============================================================================
# Recherche et traduction
# =============================================================================
# Suggestion française vers anglaise après une recherche littérale sans résultat.
DEEPL_AUTH_KEY=""
# Facultatif : vide, l’endpoint Free ou Pro est choisi à partir de la clé.
DEEPL_API_URL=""

# =============================================================================
# URL publique du site
# =============================================================================
NEXT_PUBLIC_SITE_URL="https://parigo-ten.vercel.app"

# =============================================================================
# Inventaires éditoriaux YouTube
# =============================================================================
# La clé API est prioritaire ; le parsing des pages publiques reste le repli.
YOUTUBE_API_KEY=""
YOUTUBE_SYNCHRONISATIONS_PLAYLIST_ID=""

# =============================================================================
# Sentry
# =============================================================================
# Le DSN est public ; le jeton d’upload reste strictement côté serveur.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# =============================================================================
# Automatisation des previews Vercel
# =============================================================================
VERCEL_AUTOMATION_BYPASS_SECRET=""
